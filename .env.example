# 서버 전용 GPT API 설정. 실제 키는 Git에 저장하지 않습니다.
GPT_API=your_provider_api_key_here
OPENAI_BASE_URL=https://oneport.kr/v1
OPENAI_MODEL=gpt-5.6-luna
# 추론 강도 기본값: medium. 기존 GPT 변수도 호환됩니다.
# 공식 OpenAI에서 발급한 키라면 OPENAI_BASE_URL=https://api.openai.com/v1

# 서버 포트 (기본: 3002)
PORT=3002

# Google Cloud OAuth 웹 클라이언트 ID (브라우저와 서버에서 같은 값 사용)
VITE_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Client Secret은 필요하지 않으며 프론트엔드에 넣지 않습니다.
